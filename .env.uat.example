# =============================================================================
# Lingkungan untuk otomasi UAT Modul SOP
# =============================================================================
#
# CARA PAKAI
#
#   cp .env .env.uat        # bawa kredensial lokal secara manual, jangan commit
#   # lalu TIMPA baris-baris di bawah ini pada .env.uat
#
#   php artisan serve --env=uat --port=5678     # aplikasi yang diuji Playwright
#
# BUKAN .env BARU DARI NOL. Berkas ini hanya mendaftar yang BERBEDA. Menyusun
# .env.uat dari nol berarti menyalin puluhan kunci tak terkait, dan satu saja
# yang tertinggal menghasilkan kegagalan yang terlihat seperti bug fitur.
#
# .env.uat SENGAJA masuk .gitignore — isinya kredensial database yang sama
# dengan .env. Yang boleh ter-commit hanya berkas contoh ini.
#
# -----------------------------------------------------------------------------
# DATABASE UAT TERISOLASI
# -----------------------------------------------------------------------------
# Browser UAT WAJIB memakai database terisolasi, bukan Web_HRIS development
# bersama. Target yang sudah diverifikasi untuk environment ini:
#
#   DB_HOST=team311.dyndns.info
#   DB_PORT=1433
#   DB_DATABASE=Web_HRIS_Cut_Off
#
# Web_HRIS adalah database development utama dan tidak boleh dipakai oleh
# Playwright browser yang menulis data. Database UAT harus memiliki salinan
# schema lengkap dan diverifikasi sebelum suite dijalankan.

# -----------------------------------------------------------------------------
# YANG WAJIB DITIMPA
# -----------------------------------------------------------------------------

APP_ENV=uat
DB_CONNECTION=sqlsrv
DB_HOST=team311.dyndns.info
DB_PORT=1433
DB_DATABASE=Web_HRIS_Cut_Off

# Gerbang sengaja. Tanpa ini, suite otomasi UAT menolak berjalan — supaya
# `php artisan test` biasa, IDE yang menjalankan seluruh folder tests, atau CI
# yang tak tahu apa-apa tidak pernah memicunya secara tak sengaja.
UAT_AUTO_ALLOW=1

# Modul SOP punya empat pekerjaan berantre: ProsesBulkAssignSop,
# ProsesReconcileSop, ApplySopAssignmentRule, RunSopAutomation. Penyemaian
# progres penugasan berjalan lewat antrean begitu jumlah sasaran melewati ambang
# tertentu.
#
# Tanpa `sync`, test peramban akan menerbitkan paket dan membuat penjadwalan lalu
# TIDAK MENEMUKAN APA-APA saat memeriksa SOP Saya — bukan karena aplikasinya
# salah, melainkan karena pekerjaannya menunggu di Cloud Tasks. Kegagalan itu
# terlihat persis seperti bug fitur, dan akan dikejar sebagai bug fitur.
QUEUE_CONNECTION=sync

# Halaman dev menyimpan cache yang membuat perubahan tak langsung terlihat, dan
# test peramban membaca layar segera setelah menulis.
CACHE_DRIVER=array

# -----------------------------------------------------------------------------
# AKUN UJI — isi dengan NIK sungguhan di database dev
# -----------------------------------------------------------------------------
# Test tidak membuat karyawan baru. Ia memakai akun yang sudah ada, karena data
# karyawan bersandar pada struktur organisasi, shift, dan relasi atasan yang
# tidak bisa dikarang sebagian tanpa membuat skenario lain berbohong.

# Wajib memiliki KETUJUH hak akses halaman SOP. Perhatikan: skrip
# 24A_sop_menu_akses_dml.sql hanya memuat enam — menuSopDokumenPage tidak ada di
# dalamnya karena halaman Master Dokumen lahir setelah skrip itu ditulis.
UAT_NIK_ADMIN=

# Wajib punya minimal dua bawahan aktif: menu Kepatuhan Tim menyimpulkan anggota
# dari data atasan, bukan dari hak akses.
UAT_NIK_LEADER=

# Keduanya bawahan langsung dari UAT_NIK_LEADER, supaya skenario 038 dan 039
# (kepatuhan tim, dan batas "hanya anggotanya sendiri") bisa dibuktikan.
UAT_NIK_KARYAWAN_1=
UAT_NIK_KARYAWAN_2=

# -----------------------------------------------------------------------------
# ALAMAT APLIKASI YANG DIUJI PERAMBAN
# -----------------------------------------------------------------------------
# ARAHKAN KE VHOST LARAGON, BUKAN `php artisan serve`.
#
# Di Windows, server bawaan PHP melayani SATU permintaan pada satu waktu
# (PHP_CLI_SERVER_WORKERS tidak didukung di sana). Peramban sungguhan memuat satu
# halaman berikut puluhan asetnya sekaligus, sehingga semuanya mengantre di
# belakang satu proses — halaman yang dari curl pulang dalam 5 detik butuh lebih
# dari 30 detik untuk selesai dirender.
#
# Selisihnya terukur pada suite yang sama: 54,7 menit lalu menggantung lewat
# `artisan serve`, versus 2,8 menit dan seluruhnya hijau lewat vhost Laragon.
# Gejalanya menipu — uji gagal pada "elemen tidak ditemukan", yang terbaca
# seperti selektor salah, bukan seperti server yang kehabisan napas.
UAT_BASE_URL=http://hcis-kpi-grouped.test

# CATATAN untuk spesifikasi yang MEMICU pekerjaan berantre dari peramban:
# vhost Laragon memakai .env biasa, yang QUEUE_CONNECTION-nya cloudtasks.
#
# Terukur: menerbitkan paket dari Builder lewat peramban memakan 18 DETIK pada
# satu jalan dan 55 DETIK pada jalan lain, dengan dunia uji yang sama —
# sedangkan lewat artisan --env=uat (sync) ia selesai seketika. Penugasannya
# sendiri di bawah ambang async, jadi rekonsiliasi berjalan inline; yang berayun
# adalah pengiriman notifikasi ke Cloud Tasks sesudah commit.
#
# Basis datanya sudah benar jauh sebelum layarnya berubah. Tenggat yang
# dipas-paskan ke angka tercepat akan melaporkan "penerbitan gagal" untuk
# penerbitan yang sebenarnya berhasil — dan karena lamanya berayun, kegagalan
# itu muncul sesekali saja, yang justru paling sulit dipercaya. Spesifikasi 019
# menunggu sampai 150 detik karena itu.
