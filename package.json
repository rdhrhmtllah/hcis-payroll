{
    "name": "hcis",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "setup:git": "git config core.hooksPath .githooks && git config extensions.worktreeConfig true",
        "test:unit": "vitest run",
        "test:penjaga": "vitest run .github/scripts",
        "optimize": "php artisan optimize && php artisan config:cache && php artisan config:clear",
        "host": "php artisan serve --host=0.0.0.0 --port=5678",
        "tunnel": "cloudflared tunnel run n8n-tunnel",
        "test:backend:unit": "env -u DATABASE_URL php artisan test --testsuite=Unit",
        "test:backend:feature": "env -u DATABASE_URL php artisan test --testsuite=Feature",
        "test:backend:integration": "env -u DATABASE_URL php artisan test --testsuite=Integration",
        "test:backend": "env -u DATABASE_URL php artisan test",
        "test:frontend": "npm run test:unit",
        "test:e2e": "playwright test",
        "test:e2e:gate": "node --test tests/e2e/support/browserQualityGate.test.js",
        "test:e2e:a11y": "playwright test tests/e2e/a11y.spec.js",
        "test:e2e:smoke": "playwright test tests/e2e/000-penopang.spec.js",
        "test:e2e:regression": "playwright test tests/e2e",
        "test:all": "npm run test:backend && npm run test:frontend && npm run build && npm run test:e2e:regression"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.62.1",
        "@prettier/plugin-php": "^0.24.0",
        "@storybook/addon-a11y": "^10.5.7",
        "@storybook/vue3-vite": "^10.5.7",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vue/test-utils": "^2.4.6",
        "axios": "^1.6.4",
        "jsdom": "^25.0.1",
        "laravel-vite-plugin": "^1.0.0",
        "prettier": "^3.8.1",
        "storybook": "^10.5.7",
        "swagger-ui-dist": "^5.17.14",
        "vite": "^5.0.0",
        "vitest": "^2.1.9"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@fingerprintjs/fingerprintjs": "^4.6.2",
        "@formkit/themes": "^1.6.9",
        "@formkit/vue": "^1.6.9",
        "@fullcalendar/daygrid": "^6.1.20",
        "@fullcalendar/interaction": "^6.1.20",
        "@fullcalendar/list": "^6.1.20",
        "@fullcalendar/timegrid": "^6.1.20",
        "@fullcalendar/vue3": "^6.1.20",
        "@heroicons/vue": "^2.2.0",
        "@inertiajs/vue3": "^2.0.3",
        "@lottiefiles/dotlottie-vue": "^0.6.3",
        "@mediapipe/camera_utils": "^0.3.1675466862",
        "@mediapipe/face_detection": "^0.4.1646425229",
        "@primeuix/themes": "^1.0.3",
        "apexcharts": "^5.3.1",
        "bootstrap": "^5.3.7",
        "chart.js": "^4.5.0",
        "datatables.net": "^2.3.0",
        "datatables.net-dt": "^2.3.0",
        "datatables.net-responsive-dt": "^3.0.4",
        "datatables.net-select-dt": "^3.0.0",
        "datatables.net-vue3": "^3.0.4",
        "date-fns": "^4.1.0",
        "dayjs": "^1.11.19",
        "dompurify": "^3.2.6",
        "driver.js": "^1.4.0",
        "echarts": "^6.1.0",
        "element-plus": "^2.13.1",
        "exceljs": "^4.4.0",
        "file-saver": "^2.0.5",
        "floating-vue": "^5.2.2",
        "frappe-gantt": "^1.0.3",
        "jquery": "^3.7.1",
        "js-sha256": "^0.11.1",
        "jsqr": "^1.4.0",
        "marked": "^15.0.12",
        "moment": "^2.30.1",
        "pdfjs-dist": "^4.10.38",
        "primeicons": "^7.0.0",
        "primevue": "^4.3.3",
        "quill": "^2.0.3",
        "sweetalert2": "^11.19.1",
        "turndown": "^7.2.0",
        "tus-js-client": "^4.3.1",
        "vee-validate": "^4.15.0",
        "vue": "^3.5.13",
        "vue-ganttastic": "^0.9.34",
        "vue-select": "^4.0.0-beta.6",
        "vue-spinners": "^1.0.2",
